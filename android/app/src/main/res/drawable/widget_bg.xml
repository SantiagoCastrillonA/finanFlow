<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de los widgets: degradado Marea profundo (igual en claro y oscuro). Lo bastante oscuro para que
     el texto blanco al 82 % pase 4.5:1 en todo el degradado. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/widget_bg_start"
        android:endColor="@color/widget_bg_end"
        android:type="linear" />
    <corners android:radius="22dp" />
</shape>
